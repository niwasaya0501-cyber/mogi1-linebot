# LINE Developers コンソール > Messaging API設定 から取得してください
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# オーナーへのエスカレーション通知(PUSH)を送る先のLINE userId
# 一度オーナー自身がこの公式アカウントにメッセージを送り、サーバーログの
# "[webhook] from userId:" から取得してください
LINE_OWNER_USER_ID=

# 使用するAIプロバイダー: openai / anthropic / google のいずれか(未設定時はopenai)
AI_PROVIDER=

# platform.openai.com > API keys で発行(AI_PROVIDER=openaiのとき必須)
OPENAI_API_KEY=
# console.anthropic.com > API keys で発行(AI_PROVIDER=anthropicのとき必須)
ANTHROPIC_API_KEY=
# Google AI Studio > API keys で発行(AI_PROVIDER=googleのとき必須)
GOOGLE_GENERATIVE_AI_API_KEY=

# 管理画面(/admin)のログインパスワード
ADMIN_PASSWORD=
# 管理画面のセッションCookie署名用。 `openssl rand -hex 32` などで生成
ADMIN_SESSION_SECRET=

# Supabase一時停止防止用Cron(/api/cron/keep-alive)の認証用。 `openssl rand -hex 32` などで生成
CRON_SECRET=

# Supabase連携(vercel integration add supabase)で自動追加される想定:
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY など
